# Discord bot token (required)
DISCORD_TOKEN=

# Discord user ID allowed to use owner-only commands (jishaku, etc.) (required)
OWNER_ID=

# osu! API v2 OAuth client credentials, used for /map and /calc (required)
# Create one at https://osu.ppy.sh/home/account/edit under "OAuth"
API_CLIENT_ID_OSU=
API_CLIENT_SECRET_OSU=

# Paths to the ffmpeg/ffprobe executables (optional)
# Defaults to whatever is found on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Cloudflare R2 (S3-compatible) storage, used to host downloads that exceed
# Discord's upload limit (optional — download falls back to an error message
# for oversized files if unset)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
